                "subPath": "dynamo_block_bridge.py"
              },
              {
                "mountPath": "/opt/dynamo/venv/lib/python3.12/site-packages/dynamo_bridge.pth",
                "name": "block-bridge",
                "subPath": "dynamo_bridge.pth"
              },
              {
                "mountPath": "/opt/dynamo/venv/lib/python3.12/site-packages/dynamo/vllm/migration.py",
